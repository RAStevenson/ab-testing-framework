# environments and secrets
.venv/
.env
.env.*
*.pem
credentials*

# python noise
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# local tool settings
.claude/
CLAUDE.md
AGENTS.md

# data artifacts and models — analysis figures are committed on purpose.
# data/asos/ is the one committed dataset: CC BY 4.0 with its own license
# notice, small, and pinned by md5 in analysis/asos/config.toml. Fetched
# datasets without a redistribution license (hillstrom) stay ignored, and so
# does data/synthetic/, which scripts/run_synthetic_check.py regenerates.
data/*
!data/asos/
*.parquet
*.pkl
*.pt
*.ckpt
*.h5
*.joblib
